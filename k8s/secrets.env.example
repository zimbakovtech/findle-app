# Copy this file to k8s/secrets.env and fill in real values.
# secrets.env is gitignored — never commit it.

# mongodb-secret — full replica set connection string across the 3 StatefulSet pods.
MONGODB_URL=mongodb://mongodb-0.mongodb.findle.svc.cluster.local:27017,mongodb-1.mongodb.findle.svc.cluster.local:27017,mongodb-2.mongodb.findle.svc.cluster.local:27017/?replicaSet=rs0

# backend-secret
# Generate with: openssl rand -hex 32
SECRET_KEY=your-strong-secret-key-here

FIRST_SUPERUSER_PASSWORD=changeme
